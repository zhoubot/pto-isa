分类	PTO	IR-level1	IR-level2
SSA格式，编译器做地址分配和同步，不支持alloc_tile及同步原语，只支持单输出	DPS格式，用户指定内存的复用，IR提供alloc_tile，提供同步原语/op
View	make_tensor_view	%dst = pto.make_tensor_view %ptr, shape = [sh1,sh2,sh3,sh4,sh5] strides = [st1,st2,st3,st4,st5] : !pto.tensor_view<sh1xsh2xsh3xsh4xsh5xdtype>
partition_view	%dst = pto.partition_view %src, offsets = [of1,of2,of3,of4,of5], sizes = [sh1,sh2,sh3,sh4,sh5] : !pto.tensor_view<sh1xsh2xsh3xsh4xsh5xdtype> -> !pto.partition_tensor_view<sh1xsh2xsh3xsh4xsh5xdtype>
alloc_tile(静态参数)	%dst = pto.alloc_tile : !pto.tile_buf<loc, dtype, rows, cols, v_row, v_col, blayout, slayou, fractal, pad>
alloc_tile(动态参数)	%dst = pto.alloc_tile valid_row = %vr valid_col = %vc : !pto.tile_buf<loc, dtype, rows, cols, v_row=?, v_col=?, blayout, slayou, fractal, pad>
获取核参数	get_block_idx	%idx  = pto.get_block_idx	%idx  = pto.get_block_idx
get_subblock_idx	%idx  = pto.get_subblock_idx	%idx  = pto.get_subblock_idx
get_block_num	%num  = pto.get_block_num	%num  = pto.get_block_num
get_subblock_num	%num  = pto.get_subblock_num	%num  = pto.get_subblock_num
内存	TLOAD	"%dst = pto.tload %mem : !pto.partition_tensor_view<MxNxdtype> -> 
!pto.tile<loc, dtype, rows, cols, blayout, slayou, fractal, pad>"	pto.tload ins(%mem : !pto.partition_tensor_view<MxNxdtype>) outs(%dst : !pto.tile_buf<...>)
TSTORE	"pto.tstore %src, %mem : (!pto.tile<loc, dtype, rows, cols, blayout, slayou, fractal, pad>, 
!pto.partition_tensor_view<MxNxdtype>) -> ()"	pto.tstore ins(%src : !pto.tile_buf<...>) outs(%mem : !pto.partition_tensor_view<MxNxdtype>)
TSTORE_FP	"pto.tstore.fp %src, %fp, %mem : (!pto.tile<loc, dtype, rows, cols, blayout, slayou, fractal, pad>, !pto.tile<...>, 
!pto.partition_tensor_view<MxNxdtype>) -> ()"	pto.tstore_fp ins(%src, %fp : !pto.tile_buf<...>, !pto.tile_buf<...>) outs(%mem : !pto.partition_tensor_view<MxNxdtype>)
MGATHER	"%dst = pto.mgather %mem, %idx : (!pto.partition_tensor_view<MxNxdtype>, pto.tile<...>) 
-> !pto.tile<loc, dtype, rows, cols, blayout, slayou, fractal, pad>"	pto.mgather ins(%mem, %idx : !pto.partition_tensor_view<MxNxdtype>, !pto.tile_buf<MxNxdtype) outs(%dst : !pto.tile_buf<...>)
MSCATTER	"pto.mscatter %src, %idx, %mem : (!pto.tile<loc, dtype, rows, cols, blayout, slayou, fractal, pad>, !pto.tile<...>, 
!pto.partition_tensor_view<MxNxdtype>) -> ()"	pto.mscatter ins(%src, %idx : !pto.tile_buf<...>, !pto.tile_buf<...>) outs(%mem : !pto.partition_tensor_view<MxNxdtype>)
同步	RECORD_EVENT	pto.record_event[src_op, dst_op, eventID]	支持的op：TLOAD， TSTORE_ACC，TSTORE_VEC，TMOV_M2L，TMOV_M2S，TMOV_M2B，TMOV_M2V，TMOV_V2M，TMATMUL，TVEC
WAIT_EVENT	pto.wait_event[src_op, dst_op, eventID]	支持的op：TLOAD， TSTORE_ACC，TSTORE_VEC，TMOV_M2L，TMOV_M2S，TMOV_M2B，TMOV_M2V，TMOV_V2M，TMATMUL，TVEC
