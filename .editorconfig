# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2

[*.{json,toml}]
indent_size = 2

[*.{md,mdown,mkd}]
trim_trailing_whitespace = false
indent_size = 4
max_line_length = off

[*.sh]
indent_size = 2
shell_variant = bash

[CMakeLists.txt]
indent_size = 2

[*.{cmake,cmake.in}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{svg,png,jpg,jpeg,gif,ico}]
insert_final_newline = false
trim_trailing_whitespace = false
