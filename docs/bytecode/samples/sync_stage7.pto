module {
  func.func @sync_stage7() {
    // Stage7 coverage sample: event ops + barrier + tsync
    // NOTE: This file is intended to be parseable by PTOAS/MLIR.

    pto.record_event[#pto.sync_op_type<TLOAD>, #pto.sync_op_type<TMOV_M2L>, #pto.event<EVENT_ID0>]
    pto.wait_event[#pto.sync_op_type<TLOAD>, #pto.sync_op_type<TMOV_M2L>, #pto.event<EVENT_ID0>]

    // Barrier uses a pipe attribute.
    pto.barrier #pto.pipe<PIPE_V>

    // tsync is a tile op; use dummy tile buffers just to validate parse/roundtrip.
    pto.section.vector {
      %c32 = arith.constant 32 : index
      %t0 = pto.alloc_tile valid_row = %c32 valid_col = %c32 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
      %t1 = pto.alloc_tile valid_row = %c32 valid_col = %c32 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>
      pto.tsync ins(%t0 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>) outs(%t1 : !pto.tile_buf<loc=vec, dtype=f32, rows=32, cols=32, v_row=?, v_col=?, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    }

    return
  }
}
