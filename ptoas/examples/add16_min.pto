; Minimal end-to-end test for `ptoas/mlir/build/bin/ptoas`
;
; Expected flow:
;   ptoas add16_min.pto -o add16_min.cce --insert-events --emit-bin=add16_min.bin
;
; New-format PTO-AS:
; - tensors are introduced via `pto.make_tensor_view` from implicit `%argN` kernel args
; - tiles are introduced via `pto.alloc_tile` (optionally binding an address, replacing `tassign`)
; - tile ops use `dst = pto.op ...` sugar (destination is implicit from the LHS)

.const %c16 = 16 : index
.const %c1 = 1 : index

.const %addr_x = 0x0 : index
.const %addr_y = 0x8000 : index
.const %addr_z = 0x10000 : index
.const %r0 = 0 : index
.const %c0 = 0 : index

%0 = pto.make_tensor_view %arg0, dtype=f16, shape=[%c16,%c16] strides=[%c16,%c1], layout=ND
%1 = pto.make_tensor_view %arg1, dtype=f16, shape=[%c16,%c16] strides=[%c16,%c1], layout=ND
%2 = pto.make_tensor_view %arg2, dtype=f16, shape=[%c16,%c16] strides=[%c16,%c1], layout=ND

%tx = pto.alloc_tile %addr_x : !pto.tile<loc=Vec, dtype=f16, rows=16, cols=16, blayout=RowMajor, valid=16x16, slayout=NoneBox, fractal=512, pad=Null>
%ty = pto.alloc_tile %addr_y : !pto.tile<loc=Vec, dtype=f16, rows=16, cols=16, blayout=RowMajor, valid=16x16, slayout=NoneBox, fractal=512, pad=Null>
%tz = pto.alloc_tile %addr_z : !pto.tile<loc=Vec, dtype=f16, rows=16, cols=16, blayout=RowMajor, valid=16x16, slayout=NoneBox, fractal=512, pad=Null>

%tx = pto.tload %0[%r0, %c0]
%ty = pto.tload %1[%r0, %c0]
%tz = pto.tadd %tx, %ty
pto.tstore %2[%r0, %c0], %tz
