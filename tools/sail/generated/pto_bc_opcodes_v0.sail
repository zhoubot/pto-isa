    0x2003 => Some({ has_variant_u8 = false, result_type_mode = 0x01, operand_mode = 0x00, num_operands = 0, num_results = 1, num_regions = 0, imm_kind = 0x05 })
    0x2004 => Some({ has_variant_u8 = false, result_type_mode = 0x01, operand_mode = 0x00, num_operands = 1, num_results = 1, num_regions = 0, imm_kind = 0x00 })
    0x2005 => Some({ has_variant_u8 = false, result_type_mode = 0x01, operand_mode = 0x00, num_operands = 2, num_results = 1, num_regions = 0, imm_kind = 0x00 })
    0x2006 => Some({ has_variant_u8 = false, result_type_mode = 0x01, operand_mode = 0x00, num_operands = 2, num_results = 1, num_regions = 0, imm_kind = 0x00 })
    0x2007 => Some({ has_variant_u8 = false, result_type_mode = 0x01, operand_mode = 0x00, num_operands = 3, num_results = 1, num_regions = 0, imm_kind = 0x00 })
    0x2008 => Some({ has_variant_u8 = false, result_type_mode = 0x01, operand_mode = 0x00, num_operands = 2, num_results = 1, num_regions = 0, imm_kind = 0x00 })
    0x4000 => Some({ has_variant_u8 = false, result_type_mode = 0x00, operand_mode = 0x00, num_operands = 3, num_results = 0, num_regions = 1, imm_kind = 0x00 })
    0x4001 => Some({ has_variant_u8 = false, result_type_mode = 0x00, operand_mode = 0x00, num_operands = 1, num_results = 0, num_regions = 2, imm_kind = 0x00 })
    0x4002 => Some({ has_variant_u8 = false, result_type_mode = 0x00, operand_mode = 0x02, num_operands = 0, num_results = 0, num_regions = 0, imm_kind = 0x00 })
    0x6000 => Some({ has_variant_u8 = false, result_type_mode = 0x00, operand_mode = 0x00, num_operands = 0, num_results = 0, num_regions = 0, imm_kind = 0x00 })
    0x6001 => Some({ has_variant_u8 = false, result_type_mode = 0x00, operand_mode = 0x00, num_operands = 0, num_results = 0, num_regions = 0, imm_kind = 0x00 })
  | _ => None()
  }

val opcode_operands_by_variant_gen : u16 -> int -> option(int)
function opcode_operands_by_variant_gen(op, variant) =
  match op {
    0x102A => match variant {
      0 => Some(3)
      1 => Some(4)
      2 => Some(4)
      3 => Some(5)
    | _ => None()
    }
    0x1032 => match variant {
      0 => Some(3)
      1 => Some(4)
      2 => Some(4)
    | _ => None()
    }
    0x1033 => match variant {
      0 => Some(5)
      1 => Some(6)
      2 => Some(6)
    | _ => None()
    }
  | _ => None()
  }

