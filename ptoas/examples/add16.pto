; Minimal PTO-AS demo (DPS)
;
; This example is intended to be consumed by `ptoas/tools/ptoas_build.py`.

.arg %x : !pto.tensor<dtype=f16, shape=[1,1,1,16,16], stride=[1,1,1,16,1], layout=ND>
.arg %y : !pto.tensor<dtype=f16, shape=[1,1,1,16,16], stride=[1,1,1,16,1], layout=ND>
.arg %z : !pto.tensor<dtype=f16, shape=[1,1,1,16,16], stride=[1,1,1,16,1], layout=ND>

.arg %tx : !pto.tile<loc=Vec, dtype=f16, rows=16, cols=16, blayout=RowMajor, valid=16x16, slayout=NoneBox, fractal=512, pad=Null>
.arg %ty : !pto.tile<loc=Vec, dtype=f16, rows=16, cols=16, blayout=RowMajor, valid=16x16, slayout=NoneBox, fractal=512, pad=Null>
.arg %tz : !pto.tile<loc=Vec, dtype=f16, rows=16, cols=16, blayout=RowMajor, valid=16x16, slayout=NoneBox, fractal=512, pad=Null>

.const %addr_x = 0x0 : index
.const %addr_y = 0x8000 : index
.const %addr_z = 0x10000 : index
.const %r0 = 0 : index
.const %c0 = 0 : index

tassign %tx, %addr_x : (!pto.tile<...>, index)
tassign %ty, %addr_y : (!pto.tile<...>, index)
tassign %tz, %addr_z : (!pto.tile<...>, index)

tload %tx, %x[%r0, %c0] : (!pto.tile<...>, !pto.tensor<...>, index, index)
tload %ty, %y[%r0, %c0] : (!pto.tile<...>, !pto.tensor<...>, index, index)
tadd %tz, %tx, %ty : (!pto.tile<...>, !pto.tile<...>, !pto.tile<...>)
tstore %z[%r0, %c0], %tz : (!pto.tensor<...>, index, index, !pto.tile<...>)
