; 16x16 GEMM for CPU simulator target.
;
; C = A @ B
;   A: f16[16,16]
;   B: f16[16,16]
;   C: f32[16,16]
;
; This variant uses a Left tile base layout compatible with `include/pto/cpu/TMatmul.hpp`:
;   Left  : blayout=ColMajor, slayout=RowMajor
;   Right : blayout=RowMajor, slayout=ColMajor
;   Acc   : blayout=ColMajor, slayout=RowMajor
;
; Use with:
;   ./ptoas/mlir/build/bin/ptoas ptoas/examples/gemm16_cpu.pto --target cpu -o /tmp/gemm16_cpu.cpp

prologue
%bn = pto.get_block_num : index
%bid = pto.get_block_idx : index

.const %addr_a_mat = 0x0 : index
.const %addr_b_mat = 0x20000 : index
.const %addr_a_left = 0x0 : index
.const %addr_b_right = 0x0 : index
.const %addr_c_acc = 0x0 : index

%a = pto.make_tensor_view %arg0, dtype=f16, shape=[16,16] strides=[16,1], layout=ND
%b = pto.make_tensor_view %arg1, dtype=f16, shape=[16,16] strides=[16,1], layout=ND
%c = pto.make_tensor_view %arg2, dtype=f32, shape=[16,16] strides=[16,1], layout=ND

; L1 tiles loaded from GM
%a_mat = pto.alloc_tile %addr_a_mat : !pto.tile<loc=Mat, dtype=f16, rows=16, cols=16, blayout=ColMajor, valid=16x16, slayout=RowMajor, fractal=512, pad=Null>
%b_mat = pto.alloc_tile %addr_b_mat : !pto.tile<loc=Mat, dtype=f16, rows=16, cols=16, blayout=ColMajor, valid=16x16, slayout=RowMajor, fractal=512, pad=Null>

; Matmul operands / accumulator
%a_left = pto.alloc_tile %addr_a_left : !pto.tile<loc=Left, dtype=f16, rows=16, cols=16, blayout=ColMajor, valid=16x16, slayout=RowMajor, fractal=512, pad=Null>
%b_right = pto.alloc_tile %addr_b_right : !pto.tile<loc=Right, dtype=f16, rows=16, cols=16, blayout=RowMajor, valid=16x16, slayout=ColMajor, fractal=512, pad=Null>
%c_acc = pto.alloc_tile %addr_c_acc : !pto.tile<loc=Acc, dtype=f32, rows=16, cols=16, blayout=ColMajor, valid=16x16, slayout=RowMajor, fractal=1024, pad=Null>

%a_mat = pto.tload %a[0, 0]
%b_mat = pto.tload %b[0, 0]

%a_left = pto.tmov %a_mat
%b_right = pto.tmov %b_mat

%c_acc = pto.tmatmul %a_left, %b_right
pto.tstore %c[0, 0], %c_acc

epilogue
